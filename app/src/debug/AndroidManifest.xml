<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application android:label="${com5AppLabel}" tools:replace="android:label">
        <activity android:name=".ui.DriverUiPreviewActivity" android:exported="true" />
        <activity
            android:name=".ui.DriverStateProbeActivity"
            android:enabled="${com5DiagnosticsEnabled}"
            android:exported="true" />
        <activity
            android:name=".ui.Com22InspectionActivity"
            android:enabled="${com5DiagnosticsEnabled}"
            android:exported="true" />
        <!-- COM-55 relay experiment. DUMP is held by the adb shell, not by installed apps. -->
        <receiver
            android:name=".relay.RelayConfigReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
