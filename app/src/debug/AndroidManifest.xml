<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application>
        <uses-library android:name="android.car" android:required="false" />
        <activity android:name=".diagnostics.Com9DiagnosticActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".diagnostics.Com9StopReceiver" android:exported="false" />
    </application>
</manifest>
