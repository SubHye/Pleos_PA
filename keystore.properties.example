# Copy to keystore.properties in the repository root (not committed) and fill in your own values.
# storeFile: an absolute path outside the repository, or a path relative to the repository root.
# Use forward slashes on Windows (C:/keys/pleos-pa-release.jks); a backslash is an escape here.
# A PKCS12 keystore uses one password, so storePassword and keyPassword are the same.
storeFile=
storePassword=
keyAlias=pleos-pa
keyPassword=
